<odoo>
    <!-- crone job for service reminder -->
    <record id="ir_cron_send_service_reminders" model="ir.cron">
        <field name="name">Service Reminder Emails</field>
        <field name="model_id" ref="car_detailing_services.model_car_vehicle"/>
        <field name="state">code</field>
        <field name="code">model.send_upcoming_service_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
