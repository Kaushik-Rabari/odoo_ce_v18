<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal Access Rules -->
    <record id="employee_rule" model="ir.rule">
        <field name="name">Employee Rules</field>
        <field name="model_id" ref="car_detailing_services.model_car_job_sheet"/>
        <field name="domain_force">[('related_user', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_unlink" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
    </record>

    <!-- Portal Access Rules -->
    <record id="admin_rule" model="ir.rule">
        <field name="name">Admin Rules</field>
        <field name="model_id" ref="car_detailing_services.model_car_job_sheet"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('car_detailing_services.admin_access'))]"/>
        <field name="perm_unlink" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
    </record>

</odoo>