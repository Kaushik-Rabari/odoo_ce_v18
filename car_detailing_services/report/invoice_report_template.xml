<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="invoice_report_template">
            <t t-call="web.external_layout">
                <main class="o_report_layout">
                    <t t-foreach="docs" t-as="doc">
                        <div class="page">
                            <h2>Service Invoice</h2>
                            ...
                            <p><strong>Printed: </strong><t t-esc='doc.print_count'/> time(s)</p>
                            ...
                            <p><strong>Invoice Date: </strong><t t-esc="doc.invoice_number"/></p>
                            <p><strong>Date: </strong><t t-esc="doc.invoice_date"/></p>
                            <p><strong>Status: </strong><t t-esc="dict(doc._fields['payment_status'].selection).get(doc.payment_status)"/></p>
                            
                            <br/>
                            
                            <h4>Customer Details</h4>
                            <p><strong>Name: </strong><t t-esc="doc.customer_id.name"/></p>
                            <p><strong>Vehicle: </strong><t t-esc="doc.vehicle_id.vehicle_model"/></p>
                            <p><strong>Booking: </strong><t t-esc="doc.booking_id.time_slot or '-'"/></p>

                            <br/>

                            <h4>Cost Breakdown</h4>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Description</th>
                                        <th class="text-right">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Service Charges</td>
                                        <td class="text-right">
                                            <t t-esc="doc.currency_id.symbol"/> <t t-esc="doc.service_amount"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Parts Cost</td>
                                        <td class="text-right">
                                            <strong><t t-esc="doc.currency_id.symbol"/> <t t-esc="doc.total_amount"/></strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <br/>

                            <p>Thank you for choosing our car detiling services.</p>
                        </div>
                    </t>
                </main>
            </t>
        </template>
    </data>
</odoo>