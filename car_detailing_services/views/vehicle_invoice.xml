<odoo>
    
    <record id="vehicle_invocie_list_view" model="ir.ui.view">
        <field name="name">car.invoice.list.view</field>
        <field name="model">car.invoice</field>
        <field name="arch" type="xml">
            <list string="Vehicle Invoice">
                <field name="invoice_number"/>
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <field name="service_amount"/>
                <field name="parts_amount"/>
                <field name="total_amount"/>
            </list>
        </field>
    </record>

    <record id="vehicle_invoice_form_view" model="ir.ui.view">
        <field name="name">car.invoice.form.view</field>
        <field name="model">car.invoice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- <field name="state" widget="statusbar"/> -->
                    <button type="object" string="Unpaid" name="action_unpaid_invoice"/>
                    <button type="object" string="paid" name="action_paid_invoice"/>
                    <button type="object" string="Partially paid" name="action_partially_paid_invoice"/>
                    <field name="payment_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="invoice_number" readonly="1"/>
                        <field name="job_sheet_id"/>
                        <field name="customer_id"/>
                        <field name="vehicle_id"/>
                        <field name="invoice_date"/>
                        <field name="service_amount"/>
                        <field name="parts_amount"/>
                        <field name="total_amount" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_vehicle_invoice" model="ir.actions.act_window">
        <field name="name">Vehicle Invoice</field>
        <field name="res_model">car.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="vehicle_invoice_menu"
        name="Vehicle Invoice"
        parent="car_fleet_main_menu"
        action="action_vehicle_invoice"
        sequence="60"
        groups="car_detailing_services.admin_access"
    />
</odoo>