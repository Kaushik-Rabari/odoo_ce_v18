<odoo>

    <record id="technician_detail_list_view" model="ir.ui.view">
        <field name="name">car.technician.list.view</field>
        <field name="model">car.technician</field>
        <field name="arch" type="xml">
            <list string="Technician Details">
                <field name="name"/>
                <field name="phone_no"/>
                <field name="skills"/>
                <field name="image"/>
            </list>
        </field>
    </record>
 
    <record id="technician_detail_form_view" model="ir.ui.view">
        <field name="name">car.technician.form.view</field>
        <field name="model">car.technician</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="available"/>
                        <field name="phone_no"/>
                        <field name="skills"/>
                    </group>
                    <group>
                        <field name="image"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_technician_details" model="ir.actions.act_window">
        <field name="name">Technician</field>
        <field name="res_model">car.technician</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Submenu: Technician -->
    <menuitem 
        id="technician_details"
        name="Technician Details"
        parent="car_fleet_main_menu"
        action="action_technician_details"
        sequence="40"
    />

</odoo>