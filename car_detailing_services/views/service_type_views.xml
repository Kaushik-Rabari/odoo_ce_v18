<odoo>

    <record id="servie_type_list_view" model="ir.ui.view">
        <field name="name">service.type.list.view</field>
        <field name="model">car.service.type</field>
        <field name="arch" type="xml">
            <list string="Vehicle Service Types">
                <field name="service_type"/>
                <field name="category"/>
                <field name="vehicle_type"/>
                <field name="price"/>
                <field name="duration"/>
                <field name="is_popular"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="service_type_form_view" model="ir.ui.view">
        <field name="name">service.type.form.view</field>
        <field name="model">car.service.type</field>
        <field name="arch" type="xml">
            <form string="Service Details" class="o_form_view o_form_editable">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="service_type" placeholder="Service Name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Basic Info" colspan="2">
                            <field name="category"/>
                            <field name="vehicle_type"/>
                            <field name="price"/>
                            <field name="duration"/>
                            <field name="recommended_frequency"/>
                        </group>

                        <group string="Options - Tags">
                            <field name="active"/>
                            <field name="is_popular"/>
                            <field name="includes_pickup"/>
                            <field name="gst_applicable"/>
                            <field name="tax_id"/>
                        </group>

                        <group string="Image">
                            <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe this service offering in detail..."/>
                        </page>
                        <page string="Internal Notes" invisible="1">
                            <field name="message_ids" widget="mail_thread"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vehicle_service_type" model="ir.actions.act_window">
        <field name="name">Service Type</field>
        <field name="res_model">car.service.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Submenu: Service Types -->
    <menuitem 
        id="vehicle_service_type"
        name="Service Type"
        parent="car_fleet_main_menu"
        action="action_vehicle_service_type"
        sequence="20"
        groups="car_detailing_services.admin_access"
    />

</odoo>