<odoo>

    <record id="servie_type_list_view" model="ir.ui.view">
        <field name="name">service.type.list.view</field>
        <field name="model">car.service.type</field>
        <field name="arch" type="xml">
            <list string="Vehicle Service Types">
                <field name="name"/>
                <field name="service_type"/>
                <field name="description"/>
                <field name="price"/>
                <field name="duration"/>
                <field name="category"/>
            </list>
        </field>
    </record>

    <record id="service_type_form_view" model="ir.ui.view">
        <field name="name">service.type.form.view</field>
        <field name="model">car.service.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="service_type"/>
                        <field name="description"/>
                        <field name="price"/>
                        <field name="duration"/>
                        <field name="category"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vehicle_service_type" model="ir.actions.act_window">
        <field name="name">Service Type</field>
        <field name="res_model">car.service.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Submenu: Service Types -->
    <menuitem 
        id="vehicle_service_type"
        name="Service Type"
        parent="car_fleet_main_menu"
        action="action_vehicle_service_type"
        sequence="20"
    />

</odoo>